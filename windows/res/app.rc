#include <winuser.h>
#include <winver.h>

1 ICON "app.ico"
2 ICON "app_off.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// Name and publisher shown in Settings > Apps > Startup and Task Manager.
VS_VERSION_INFO VERSIONINFO
FILEVERSION WINDROP_V1,WINDROP_V2,WINDROP_V3,0
PRODUCTVERSION WINDROP_V1,WINDROP_V2,WINDROP_V3,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "WinDrop"
      VALUE "FileDescription", "WinDrop"
      VALUE "FileVersion", WINDROP_VERSION
      VALUE "InternalName", "WinDrop"
      VALUE "OriginalFilename", "WinDrop.exe"
      VALUE "ProductName", "WinDrop"
      VALUE "ProductVersion", WINDROP_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
